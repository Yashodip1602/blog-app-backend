# ────────────────────────────────────────────────────────────
#  ENVIRONMENT & SECRETS
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
config/local.*


# ────────────────────────────────────────────────────────────
#  NODE.JS / NPM / YARN / PNPM
# ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json.bak


# ────────────────────────────────────────────────────────────
#  TYPESCRIPT
